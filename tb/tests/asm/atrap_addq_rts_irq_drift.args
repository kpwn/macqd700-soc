# atrap_addq_rts_irq_drift.args — IRQ sweep through A-line dispatcher
# exit windows.  Companion to atrap_addq_rts_irq_drift.s.
#
# 200 IRQs at 200-cycle spacing — covers the per-trap exit window
# (MOVEM-pop / ADDQ / RTS sequence is ~10 cycles).  Each +ipl=N:1
# fires once; cpu_ipl_ack clears.

+timeout=5000000

+ipl=200:1
+ipl=400:1
+ipl=600:1
+ipl=800:1
+ipl=1000:1
+ipl=1200:1
+ipl=1400:1
+ipl=1600:1
+ipl=1800:1
+ipl=2000:1
+ipl=2200:1
+ipl=2400:1
+ipl=2600:1
+ipl=2800:1
+ipl=3000:1
+ipl=3200:1
+ipl=3400:1
+ipl=3600:1
+ipl=3800:1
+ipl=4000:1
+ipl=4200:1
+ipl=4400:1
