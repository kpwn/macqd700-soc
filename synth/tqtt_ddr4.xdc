# TQTT KU5P DDR4 package pins, from vendor examples/06-ddr4-sdram/pin.txt.
# The reference clock is 100 MHz. Differential mate pins are paired by Vivado.

set_property IOSTANDARD DIFF_SSTL12_DCI [get_ports {c0_ddr4_ck_t[0]}]
set_property IOSTANDARD LVCMOS12 [get_ports sys_rst]
set_property PACKAGE_PIN P19 [get_ports sys_rst]
set_property PACKAGE_PIN T24 [get_ports c0_sys_clk_p]
set_property PACKAGE_PIN U24 [get_ports c0_sys_clk_n]
set_property IOSTANDARD DIFF_SSTL12 [get_ports {c0_sys_clk_p c0_sys_clk_n}]
set_property IOSTANDARD SSTL12_DCI [get_ports {c0_ddr4_act_n c0_ddr4_adr[*] c0_ddr4_ba[*] c0_ddr4_bg[*] c0_ddr4_cke[*] c0_ddr4_odt[*] c0_ddr4_cs_n[*]}]
set_property IOSTANDARD POD12_DCI [get_ports {c0_ddr4_dq[*] c0_ddr4_dm_dbi_n[*]}]
set_property IOSTANDARD DIFF_POD12_DCI [get_ports {c0_ddr4_dqs_t[*] c0_ddr4_dqs_c[*]}]
set_property IOSTANDARD DIFF_SSTL12_DCI [get_ports {c0_ddr4_ck_t[*] c0_ddr4_ck_c[*]}]
set_property IOSTANDARD LVCMOS12 [get_ports c0_ddr4_reset_n]
