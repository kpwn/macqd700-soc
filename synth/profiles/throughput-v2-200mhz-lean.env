# Full SoC candidate: keep counters/control, omit waveform and storage trace IP.
# Export when sourcing: set -a; . synth/profiles/throughput-v2-200mhz-lean.env; set +a
CPU=m68k040
CPU_IPC_PROFILE=throughput-v2
CPU_DEBUG_PROFILE=reduced
# Experimental eight-way refill predecode, overlapping owned AXI responses.
ICACHE_PREDECODE_WORDS=8
REAL_FPGA_BUILD=1
USE_REAL_MIG=1
TARGET_FREQ_MHZ=200
CORE_MMCM=1
CORE_CLK_DIVIDE=1
CORE_CLK_HZ=200000000
PB_CLK_HZ=50000000
PERF_DETAIL_ENABLE=1
ENABLE_IPC_ILA=0
ENABLE_ILA=0
ENABLE_SCSI_TRACE=0
ENABLE_VIO=1
ENABLE_JTAG_AXI=1
ENABLE_PCIE_XDMA=0
ALLOW_UNDEBUGGABLE_FPGA_BUILD=0
ETH_ENABLE=1
ETH_ICMP_RESPONDER=0
ETH_DEBUG_ENABLE=0
VIDEO_SMOKE=0
BOOT_ROM_SECTORS=2048
SD_SAFE_CMD25=0
L2C_ENABLE=1
VRAM_IN_DDR=1
NO_INCREMENTAL=1
