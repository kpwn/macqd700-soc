# Matched 200 MHz board candidate validated on 2026-10-24.
# Source with set -a so the CPU generator and Vivado inherit every option.
# CPU hardware: 00df756f (later CPU master commits change harness/docs only).
# SoC RTL: 8284a403 (later SoC main commits change only the cpu040 gitlink).
CPU=m68k040
CPU_IPC_PROFILE=throughput-v2
CPU_DEBUG_PROFILE=reduced
LS_OOO_ISSUE=1
CPU_INHIBITED_FULL_BARRIER=1
CPU_DCACHE_NONBLOCKING=1
CPU_AXI_DH=1
CPU_DCACHE_MSHRS=4
CPU_LS_LOAD_RING_DEPTH=4
CPU_DCACHE_SECTORED=0
CPU_DCACHE_NB_EARLY_RESPONSE=1
CPU_DCACHE_NB_EAGER_AR=1
CPU_DCACHE_NB_PRESELECT_AR=0
CPU_DCACHE_NB_DYNAMIC_RELEASE=0
CPU_DCACHE_NB_PROBE_MISS_STAGE=0
CPU_AXI_DH_AR_FALL_THROUGH=0
CPU_DCACHE_STORE_AR_DELAY=0
CPU_DCACHE_FULLLINE_NOFILL=0
CPU_SQ_COALESCE_LINES=0
CPU_PHYS_NZVC=32
CPU_PHYS_X=32
CPU_LS_EARLY_AN_RETRY=1
CPU_MOVE_SRC_AN_LATE=1
CPU_STORE_AN_ALU=1
CPU_LS_SPLIT_ONE_XLATE=1
CPU_LS_SPLIT_FWD=1
TARGET_FREQ_MHZ=200
ENABLE_SCSI_TRACE=1
SD_SAFE_CMD25=0
PLACE_DIRECTIVE=AltSpreadLogic_high
ROUTE_DIRECTIVE=AggressiveExplore
SBT_OPTS='-Xmx6g -Xss16m'
