# TQTT full Mac SoC constraints; DDR pins derive from the qualified MIG probe.
# TQTT KU5P DDR4 package pins, from vendor examples/06-ddr4-sdram/pin.txt.
# The reference clock is 100 MHz. Differential mate pins are paired by Vivado.

# Boot from the board's configuration SPI flash.  The standalone TQTT probes
# already use SPIx4 at 51 MHz; keep the full Mac image on the same settings.
# Compression reduces the time spent in configuration
# before the Mac design can drive HDMI, LEDs, and the fan.
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]
set_property CONFIG_MODE SPIx4 [current_design]
set_property BITSTREAM.CONFIG.CONFIGRATE 51.0 [current_design]

set_property IOSTANDARD DIFF_SSTL12_DCI [get_ports {ddr4_ck_t[0]}]
set_property IOSTANDARD LVCMOS12 [get_ports tqtt_reset]
set_property PACKAGE_PIN P19 [get_ports tqtt_reset]
set_property PACKAGE_PIN T24 [get_ports sys_clk_p]
set_property PACKAGE_PIN U24 [get_ports sys_clk_n]
set_property IOSTANDARD DIFF_SSTL12 [get_ports {sys_clk_p sys_clk_n}]
set_property IOSTANDARD SSTL12_DCI [get_ports {ddr4_act_n ddr4_adr[*] ddr4_ba[*] ddr4_bg[*] ddr4_cke[*] ddr4_odt[*] ddr4_cs_n[*]}]
set_property IOSTANDARD POD12_DCI [get_ports {ddr4_dq[*] ddr4_dm_dbi_n[*]}]
set_property IOSTANDARD DIFF_POD12_DCI [get_ports {ddr4_dqs_t[*] ddr4_dqs_c[*]}]
set_property IOSTANDARD DIFF_SSTL12_DCI [get_ports {ddr4_ck_t[*] ddr4_ck_c[*]}]
set_property IOSTANDARD LVCMOS12 [get_ports ddr4_reset_n]
set _tqtt_mig_phys_ports [get_ports {
    sys_clk_p sys_clk_n
    ddr4_act_n ddr4_reset_n
    ddr4_adr[*] ddr4_ba[*] ddr4_bg[*]
    ddr4_cke[*] ddr4_odt[*] ddr4_cs_n[*]
    ddr4_ck_t[*] ddr4_ck_c[*]
    ddr4_dq[*] ddr4_dqs_t[*] ddr4_dqs_c[*] ddr4_dm_dbi_n[*]
}]
# The stitched MIG DCP owns its physical IO buffers. Match the RK full-SoC
# contract; standalone TQTT DDR4 probe used synth_design -no_iobuf instead.
set_property IO_BUFFER_TYPE NONE $_tqtt_mig_phys_ports
set_property CLOCK_BUFFER_TYPE NONE $_tqtt_mig_phys_ports
#########################################################################################
set_property PACKAGE_PIN ad24 [get_ports {ddr4_dq[0]}]
set_property PACKAGE_PIN af24 [get_ports {ddr4_dq[1]}]
set_property PACKAGE_PIN ab26 [get_ports {ddr4_dq[2]}]
set_property PACKAGE_PIN ab24 [get_ports {ddr4_dq[3]}]
set_property PACKAGE_PIN ac24 [get_ports {ddr4_dq[4]}]
set_property PACKAGE_PIN ab25 [get_ports {ddr4_dq[5]}]
set_property PACKAGE_PIN af25 [get_ports {ddr4_dq[6]}]
set_property PACKAGE_PIN ad25 [get_ports {ddr4_dq[7]}]
set_property PACKAGE_PIN ad23 [get_ports {ddr4_dq[8]}]
set_property PACKAGE_PIN ae23 [get_ports {ddr4_dq[9]}]
set_property PACKAGE_PIN ad21 [get_ports {ddr4_dq[10]}]
set_property PACKAGE_PIN ac23 [get_ports {ddr4_dq[11]}]
set_property PACKAGE_PIN ac22 [get_ports {ddr4_dq[12]}]
set_property PACKAGE_PIN ae21 [get_ports {ddr4_dq[13]}]
set_property PACKAGE_PIN ab21 [get_ports {ddr4_dq[14]}]
set_property PACKAGE_PIN ac21 [get_ports {ddr4_dq[15]}]
set_property PACKAGE_PIN af17 [get_ports {ddr4_dq[16]}]
set_property PACKAGE_PIN ae17 [get_ports {ddr4_dq[17]}]
set_property PACKAGE_PIN ac19 [get_ports {ddr4_dq[18]}]
set_property PACKAGE_PIN af18 [get_ports {ddr4_dq[19]}]
set_property PACKAGE_PIN af19 [get_ports {ddr4_dq[20]}]
set_property PACKAGE_PIN ad19 [get_ports {ddr4_dq[21]}]
set_property PACKAGE_PIN ae16 [get_ports {ddr4_dq[22]}]
set_property PACKAGE_PIN ad16 [get_ports {ddr4_dq[23]}]
set_property PACKAGE_PIN ab20 [get_ports {ddr4_dq[24]}]
set_property PACKAGE_PIN ab19 [get_ports {ddr4_dq[25]}]
set_property PACKAGE_PIN aa19 [get_ports {ddr4_dq[26]}]
set_property PACKAGE_PIN aa20 [get_ports {ddr4_dq[27]}]
set_property PACKAGE_PIN y17  [get_ports {ddr4_dq[28]}]
set_property PACKAGE_PIN aa17 [get_ports {ddr4_dq[29]}]
set_property PACKAGE_PIN y18  [get_ports {ddr4_dq[30]}]
set_property PACKAGE_PIN aa18 [get_ports {ddr4_dq[31]}]
set_property PACKAGE_PIN p26 [get_ports {ddr4_adr[0]}]
set_property PACKAGE_PIN p25 [get_ports {ddr4_adr[1]}]
set_property PACKAGE_PIN r22 [get_ports {ddr4_adr[2]}]
set_property PACKAGE_PIN aa24 [get_ports {ddr4_adr[3]}]
set_property PACKAGE_PIN t23 [get_ports {ddr4_adr[4]}]
set_property PACKAGE_PIN w20 [get_ports {ddr4_adr[5]}]
set_property PACKAGE_PIN t22 [get_ports {ddr4_adr[6]}]
set_property PACKAGE_PIN w19 [get_ports {ddr4_adr[7]}]
set_property PACKAGE_PIN u21 [get_ports {ddr4_adr[8]}]
set_property PACKAGE_PIN p21 [get_ports {ddr4_adr[9]}]
set_property PACKAGE_PIN v22 [get_ports {ddr4_adr[10]}]
set_property PACKAGE_PIN u19 [get_ports {ddr4_adr[11]}]
set_property PACKAGE_PIN y25 [get_ports {ddr4_adr[12]}]
set_property PACKAGE_PIN p20 [get_ports {ddr4_adr[13]}]
set_property PACKAGE_PIN y23 [get_ports {ddr4_adr[14]}]
set_property PACKAGE_PIN u26 [get_ports {ddr4_adr[15]}]
set_property PACKAGE_PIN v26 [get_ports {ddr4_adr[16]}]
set_property PACKAGE_PIN ac26 [get_ports {ddr4_dqs_t[0]}]
set_property PACKAGE_PIN aa22 [get_ports {ddr4_dqs_t[1]}]
set_property PACKAGE_PIN ac18 [get_ports {ddr4_dqs_t[2]}]
set_property PACKAGE_PIN ab17 [get_ports {ddr4_dqs_t[3]}]
set_property PACKAGE_PIN u22 [get_ports {ddr4_ba[0]}]
set_property PACKAGE_PIN r26 [get_ports {ddr4_ba[1]}]
set_property PACKAGE_PIN ae25 [get_ports {ddr4_dm_dbi_n[0]}]
set_property PACKAGE_PIN ae22 [get_ports {ddr4_dm_dbi_n[1]}]
set_property PACKAGE_PIN ad20 [get_ports {ddr4_dm_dbi_n[2]}]
set_property PACKAGE_PIN y20 [get_ports {ddr4_dm_dbi_n[3]}]
set_property PACKAGE_PIN v21 [get_ports {ddr4_bg[0]}]
set_property PACKAGE_PIN p23 [get_ports ddr4_reset_n]
set_property PACKAGE_PIN v19 [get_ports ddr4_act_n]
set_property PACKAGE_PIN aa25 [get_ports {ddr4_odt[0]}]
set_property PACKAGE_PIN w25 [get_ports {ddr4_ck_t[0]}]
set_property PACKAGE_PIN y22 [get_ports {ddr4_cke[0]}]
set_property PACKAGE_PIN y26 [get_ports {ddr4_cs_n[0]}]

# The MIG DCP supplies the 10 ns reference-clock constraint.

# TQTT fabric oscillator. The +ADJ rail must be checked before hardware load.
set_property -dict {PACKAGE_PIN E18 IOSTANDARD LVCMOS18} [get_ports fabric_clk_50]
create_clock -name tqtt_fabric_50 -period 20.000 [get_ports fabric_clk_50]
# P19 switch, CP2105 UART2, status LEDs, and inverting fan driver.
set_property -dict {PACKAGE_PIN H17 IOSTANDARD LVCMOS18} [get_ports uart_rtl_0_rxd]
set_property -dict {PACKAGE_PIN G19 IOSTANDARD LVCMOS18} [get_ports uart_rtl_0_txd]
set_property -dict {PACKAGE_PIN E16 IOSTANDARD LVCMOS18} [get_ports {led[0]}]
set_property -dict {PACKAGE_PIN E17 IOSTANDARD LVCMOS18} [get_ports {led[1]}]
set_property -dict {PACKAGE_PIN F15 IOSTANDARD LVCMOS18} [get_ports {led[2]}]
set_property -dict {PACKAGE_PIN D15 IOSTANDARD LVCMOS18} [get_ports {led[3]}]
set_property -dict {PACKAGE_PIN E15 IOSTANDARD LVCMOS18} [get_ports fan_pwm]
set_property -dict {PACKAGE_PIN G17 IOSTANDARD LVCMOS18} [get_ports fan_fb]
# J8 SD pins are selected in vivado.tcl from tqtt_sd_spi.xdc or
# tqtt_sd_native.xdc. XDC does not allow Tcl `if` commands here.
# Direct TMDS, qualified by the standalone HDMI probe.
set_property PACKAGE_PIN T25 [get_ports tmds_clk_p]
set_property PACKAGE_PIN U25 [get_ports tmds_clk_n]
set_property PACKAGE_PIN N24 [get_ports {tmds_p[0]}]
set_property PACKAGE_PIN P24 [get_ports {tmds_n[0]}]
set_property PACKAGE_PIN V24 [get_ports {tmds_p[1]}]
set_property PACKAGE_PIN W24 [get_ports {tmds_n[1]}]
set_property PACKAGE_PIN V23 [get_ports {tmds_p[2]}]
set_property PACKAGE_PIN W23 [get_ports {tmds_n[2]}]
set_property IOSTANDARD DIFF_SSTL12 [get_ports {tmds_clk_p tmds_clk_n tmds_p[*] tmds_n[*]}]
set_property -dict {PACKAGE_PIN Y16 IOSTANDARD LVCMOS33} [get_ports hdmi_out_en]
# RTL8211EG GMII in bank 87.
set_property PACKAGE_PIN E12 [get_ports {phy_txd[0]}]
set_property PACKAGE_PIN F13 [get_ports {phy_txd[1]}]
set_property PACKAGE_PIN C14 [get_ports {phy_txd[2]}]
set_property PACKAGE_PIN C12 [get_ports {phy_txd[3]}]
set_property PACKAGE_PIN B12 [get_ports {phy_txd[4]}]
set_property PACKAGE_PIN A12 [get_ports {phy_txd[5]}]
set_property PACKAGE_PIN A13 [get_ports {phy_txd[6]}]
set_property PACKAGE_PIN B14 [get_ports {phy_txd[7]}]
set_property PACKAGE_PIN F12 [get_ports {phy_rxd[0]}]
set_property PACKAGE_PIN G14 [get_ports {phy_rxd[1]}]
set_property PACKAGE_PIN G12 [get_ports {phy_rxd[2]}]
set_property PACKAGE_PIN H14 [get_ports {phy_rxd[3]}]
set_property PACKAGE_PIN J15 [get_ports {phy_rxd[4]}]
set_property PACKAGE_PIN J14 [get_ports {phy_rxd[5]}]
set_property PACKAGE_PIN H13 [get_ports {phy_rxd[6]}]
set_property PACKAGE_PIN J13 [get_ports {phy_rxd[7]}]
set_property PACKAGE_PIN E13 [get_ports phy_tx_clk]
set_property PACKAGE_PIN D14 [get_ports phy_rx_clk]
set_property PACKAGE_PIN F14 [get_ports phy_tx_en]
set_property PACKAGE_PIN A14 [get_ports phy_tx_er]
set_property PACKAGE_PIN H12 [get_ports phy_rx_dv]
set_property PACKAGE_PIN J12 [get_ports phy_rx_er]
set_property PACKAGE_PIN D13 [get_ports phy_reset_n]
set_property IOSTANDARD LVCMOS33 [get_ports {phy_rx_clk phy_rxd[*] phy_rx_dv phy_rx_er phy_tx_clk phy_txd[*] phy_tx_en phy_tx_er phy_reset_n}]
set_property DRIVE 8 [get_ports {phy_tx_clk phy_txd[*] phy_tx_en phy_tx_er phy_reset_n}]
set_property SLEW FAST [get_ports phy_tx_clk]
set_property SLEW SLOW [get_ports {phy_txd[*] phy_tx_en phy_tx_er phy_reset_n}]
create_clock -period 8.000 -name tqtt_gmii_rxclk125 [get_ports phy_rx_clk]
