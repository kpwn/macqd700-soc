#!/usr/bin/env bash
# tools/pm/watch-synth — tail a Vivado log, emit only the SIGNAL lines.
#
# Usage: tools/pm/watch-synth <vivado-log-path>
# Filters the log stream down to:
#   - URAM/BRAM/LUT resource summaries
#   - WNS / worst-slack timing lines
#   - "Writing bitstream"
#   - ERROR / CRITICAL WARNING / Abnormal termination
# Exits 0 when bitstream written; 1 if synth fails or log disappears.

set -uo pipefail

PROG="${0##*/}"
usage() {
    echo "usage: $PROG <vivado-log-path>"
    echo "  tail a Vivado synth/impl log, surfacing only SIGNAL events."
    echo "  exits 0 on bitstream complete, 1 on error."
}

case "${1:-}" in -h|--help) usage; exit 0 ;; esac
[ $# -eq 0 ] && { usage >&2; exit 1; }
LOG="$1"

# Wait up to 60s for the log to appear (synth startup)
for _ in $(seq 1 30); do
    [ -e "$LOG" ] && break
    sleep 2
done
if [ ! -e "$LOG" ]; then
    echo "$PROG: log not found after 60s: $LOG" >&2
    exit 1
fi

# Signal regex — kept permissive: Vivado log format varies by version.
# grep --line-buffered for low-latency streaming.
PAT='URAM|BRAM|LUT as Logic|Slice LUTs|Slice Registers|WNS|Worst Negative Slack|Worst slack|Writing bitstream|write_bitstream|Starting.*implementation|Starting.*synthesis|ERROR:|CRITICAL WARNING|Abnormal program termination|Phase [0-9]+.*Complete|Route Design|Place Design'

# Follow the log. Use awk so we can emit an exit code on the terminator.
exec < <(tail -F -n +1 "$LOG" 2>/dev/null)

RC=1
while IFS= read -r line; do
    if echo "$line" | grep -qE "$PAT"; then
        # trim leading timestamp clutter if present
        clean=$(echo "$line" | sed -E 's/^INFO: \[Common 17-206\] +//')
        echo "$clean"
        if echo "$line" | grep -q "write_bitstream completed"; then
            RC=0; break
        fi
        if echo "$line" | grep -q "Writing bitstream.*complete"; then
            RC=0; break
        fi
        if echo "$line" | grep -qE 'Abnormal program termination|ERROR: \[Common'; then
            RC=1; break
        fi
    fi
done
exit $RC
